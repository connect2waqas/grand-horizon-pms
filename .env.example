# ==============================================================================
# Grand Horizon Hotel Management System - Environment Variables
# ==============================================================================

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct Connection)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password_here@db.your_project_ref.supabase.co:5432/postgres

# Environment Mode (development / production)
ENVIRONMENT=production
